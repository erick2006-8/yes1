generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id       Int    @id @default(autoincrement())
  nombre   String
  correo   String @unique
  password String
}

model Producto {
  id      Int      @id @default(autoincrement())
  nombre  String
  stock   Int      @default(0)
  pedidos Pedido[]
}

model Pedido {
  id         Int          @id @default(autoincrement())
  estado     EstadoPedido @default(PENDIENTE)
  productoId Int
  cantidad   Int
  clienteId  Int

  producto Producto @relation(fields: [productoId], references: [id])

  @@index([clienteId, estado, productoId])
}

enum EstadoPedido {
  PENDIENTE
  ENTREGADO
  NEGADO
}
